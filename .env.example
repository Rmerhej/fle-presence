# Copier ce fichier en ".env" puis remplir les valeurs. Le fichier .env n'est jamais envoyé sur GitHub.

# Base de données
DB_USER=fle
DB_PASSWORD=change-moi
DB_ROOT_PASSWORD=change-moi-aussi

# Compte administrateur créé au premier démarrage
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-moi-encore

# Ports sur la machine
APP_PORT=8080
PMA_PORT=8081

# Image Docker (pour docker push sur Docker Hub)
APP_IMAGE=rolandmerhej1/fle-presence:latest

# Liens du pied de page (laisser vide pour ne pas les afficher)
APP_LIEN_FRENCH_FOR_BEGINNERS=
APP_LIEN_BENEVOLAT=
APP_LIEN_FACEBOOK=
APP_LIEN_INSTAGRAM=
APP_LIEN_LINKEDIN=
APP_LIEN_YOUTUBE=
APP_LIEN_X=

# Caddy : HTTPS automatique (certificat Let's Encrypt) devant l'application.
# Le nom de domaine vient de la variable DOMAINE du fichier .env.
{$DOMAINE} {
    encode zstd gzip
    reverse_proxy app:8080

    # En-têtes de sécurité, ajoutés à toutes les réponses
    header {
        # Toujours HTTPS (le navigateur s'en souvient un an)
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Le site ne peut pas être affiché dans un cadre d'un autre site (anti-« clickjacking »)
        X-Frame-Options "DENY"
        Cross-Origin-Opener-Policy "same-origin"
        # Aucun accès à la caméra, au micro, à la position…
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        # Le navigateur ne charge que nos fichiers et ceux des CDN utilisés (Bootstrap, polices, graphiques, QR code)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        -Server
    }
}
